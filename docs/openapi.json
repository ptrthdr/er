{
  "openapi": "3.1.0",
  "info": {
    "title": "CodeLobby Execution — trusted team API",
    "version": "1.0.0",
    "description": "Server-to-server API. Browser calls the main backend, never this API with its secret. Demo /api endpoints are intentionally outside the integration contract. Single process; one sandbox operation at a time, 10 queued jobs and 100 retained records. Queue payload/body validation precedes acceptance."
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "InternalKey": []
    }
  ],
  "paths": {
    "/internal/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED; configure server key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EXECUTION_ERROR / INTERNAL_API_DISABLED; synchronous sandbox waits <= 2 seconds; queued jobs wait interruptibly until free",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/runs": {
      "post": {
        "operationId": "runCode",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST / INVALID_JSON / INVALID_EVALUATION; fix payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED; configure server key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EXECUTION_ERROR / INTERNAL_API_DISABLED; synchronous sandbox waits <= 2 seconds; queued jobs wait interruptibly until free",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          }
        }
      }
    },
    "/internal/v1/evaluations": {
      "post": {
        "operationId": "evaluateSynchronously",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST / INVALID_JSON / INVALID_EVALUATION; fix payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED; configure server key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EXECUTION_ERROR / INTERNAL_API_DISABLED; synchronous sandbox waits <= 2 seconds; queued jobs wait interruptibly until free",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          }
        }
      }
    },
    "/internal/v1/evaluation-jobs": {
      "post": {
        "operationId": "enqueueEvaluation",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST / INVALID_JSON / INVALID_EVALUATION; fix payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED; configure server key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "SUBMISSION_ID_CONFLICT; use matching payload or new ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE; reduce suite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "QUEUE_CAPACITY_EXCEEDED; not admitted, retry later with same ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EXECUTION_ERROR / INTERNAL_API_DISABLED; synchronous sandbox waits <= 2 seconds; queued jobs wait interruptibly until free",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              },
              "example": {
                "submissionId": "team-vowels-001",
                "language": "CPP",
                "mode": "FUNCTION",
                "adapterId": "vowel-count-v1",
                "sourceCode": "int countVowels(const string& text) { int count = 0; for (char c : text) if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') ++count; return count; }",
                "limits": {
                  "cpuTimeMs": 2000,
                  "wallTimeMs": 5000,
                  "memoryLimitBytes": 128000000
                },
                "testCases": [
                  {
                    "input": "codelobby\n",
                    "expectedOutput": "3\n",
                    "visibility": "PUBLIC"
                  },
                  {
                    "input": "aeiou\n",
                    "expectedOutput": "5\n",
                    "visibility": "HIDDEN"
                  },
                  {
                    "input": "\n",
                    "expectedOutput": "0\n",
                    "visibility": "HIDDEN"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/internal/v1/evaluation-jobs/{id}": {
      "get": {
        "operationId": "getEvaluationJob",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED; configure server key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "JOB_NOT_FOUND; may have expired or been lost after restart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EXECUTION_ERROR / INTERNAL_API_DISABLED; synchronous sandbox waits <= 2 seconds; queued jobs wait interruptibly until free",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "submissionId from the accepted request"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InternalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CodeLobby-Internal-Key"
      }
    },
    "schemas": {
      "Language": {
        "type": "string",
        "enum": [
          "CPP",
          "PYTHON",
          "JAVA"
        ]
      },
      "Mode": {
        "type": "string",
        "enum": [
          "FULL_PROGRAM",
          "FUNCTION",
          "PALINDROME_FUNCTION"
        ],
        "description": "PALINDROME_FUNCTION is a legacy alias. Omitted/null mode defaults to FULL_PROGRAM."
      },
      "Limits": {
        "type": "object",
        "properties": {
          "cpuTimeMs": {
            "type": "integer",
            "minimum": 1
          },
          "wallTimeMs": {
            "type": "integer",
            "minimum": 1
          },
          "memoryLimitBytes": {
            "type": "integer",
            "minimum": 1000
          }
        },
        "required": [
          "cpuTimeMs",
          "wallTimeMs",
          "memoryLimitBytes"
        ],
        "description": "Milliseconds and bytes. Deployment maxima apply (local default CPU 2000 ms, wall 5000 ms, memory 128000000 bytes). wallTimeMs >= cpuTimeMs. FUNCTION limits apply to whole correctness suite; FULL_PROGRAM per test. Benchmark FUNCTION has a separate bounded aggregate budget."
      },
      "TestCase": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "maxLength": 100000
          },
          "expectedOutput": {
            "type": "string",
            "maxLength": 100000
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "HIDDEN"
            ]
          }
        },
        "required": [
          "input",
          "expectedOutput",
          "visibility"
        ]
      },
      "EvaluationRequest": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "sourceCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Mode"
              },
              {
                "type": "null"
              }
            ]
          },
          "adapterId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "testCases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/TestCase"
            }
          }
        },
        "required": [
          "submissionId",
          "language",
          "sourceCode",
          "limits",
          "testCases"
        ],
        "description": "IDs/code must contain non-whitespace. FUNCTION requires a registered adapterId and valid adapter inputs/outputs. FULL_PROGRAM forbids adapterId. Async serialized payload <= 2000000 bytes. Trusted main backend enforces ownership and lobby language policy."
      },
      "RunRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "sourceCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Mode"
              },
              {
                "type": "null"
              }
            ]
          },
          "adapterId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "stdin": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "requestId",
          "language",
          "sourceCode",
          "limits",
          "stdin"
        ]
      },
      "Verdict": {
        "type": "string",
        "enum": [
          "ACCEPTED",
          "COMPLETED",
          "WRONG_ANSWER",
          "COMPILATION_ERROR",
          "RUNTIME_ERROR",
          "TIME_LIMIT_EXCEEDED",
          "MEMORY_LIMIT_EXCEEDED",
          "EXECUTION_ERROR"
        ]
      },
      "ExecutionResult": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Verdict"
          },
          "stdout": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stderr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "compileOutput": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "engineStatus": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "executionTimeMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "memoryBytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Benchmark": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "FAILED"
            ]
          },
          "warmupRuns": {
            "type": "integer",
            "minimum": 0
          },
          "measuredRuns": {
            "type": "integer",
            "minimum": 0
          },
          "medianRuntimeMs": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "peakMemoryBytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "measurementScope": {
            "type": "string",
            "enum": [
              "FUNCTION_CALLS_ELAPSED",
              "SUITE_PROCESS_CPU"
            ]
          },
          "measurementTrust": {
            "type": "string",
            "enum": [
              "IN_PROCESS_UNTRUSTED",
              "SANDBOX"
            ]
          },
          "sandboxCpuTimeMs": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "warmupRuns",
          "measuredRuns",
          "measurementScope",
          "measurementTrust"
        ],
        "description": "2 warmups and 5 measured rounds when completed. FUNCTION median is elapsed function-call time, in-process and manipulable; peak memory covers whole process including warmups. sandboxCpuTimeMs covers full benchmark process. FULL_PROGRAM reports median sum of process CPU per round. Do not rank FAILED or missing metrics."
      },
      "TestResult": {
        "type": "object",
        "properties": {
          "testNumber": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "$ref": "#/components/schemas/Verdict"
          },
          "runtimeMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "peakMemoryBytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stderr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedOutput": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "visibility": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PUBLIC",
                  "HIDDEN"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "testNumber",
          "status"
        ],
        "description": "Hidden output, stderr, expectedOutput are null. Compilation errors return no test records. FUNCTION per-test time/memory are null; interrupted batch may report 0 passed and best-effort interrupted index in message."
      },
      "SubmissionResult": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Verdict"
          },
          "passedTests": {
            "type": "integer",
            "minimum": 0
          },
          "totalTests": {
            "type": "integer",
            "minimum": 1
          },
          "runtimeMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "peakMemoryBytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "compileOutput": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "engineStatus": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "testResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestResult"
            }
          },
          "benchmark": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Benchmark"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "passedTests",
          "totalTests",
          "testResults"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "FINISHED",
              "FAILED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubmissionResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "submissionId",
          "state",
          "createdAt"
        ],
        "description": "FINISHED means evaluation finished, not necessarily Accepted. FAILED means engine/job failure. QUEUED includes waiting for sandbox. RAM only: all jobs lost at restart; completed results expire after 30 min. Same ID + identical payload replays stored job, different payload -> 409. Use a new ID for an intentional retry after FAILED. No durable exactly-once guarantee."
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "error"
        ]
      },
      "LanguageProfile": {
        "type": "object",
        "properties": {
          "functionName": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "starterCode": {
            "type": "string"
          },
          "sourceShape": {
            "type": "string"
          }
        },
        "required": [
          "functionName",
          "signature",
          "starterCode",
          "sourceShape"
        ]
      },
      "Adapter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "inputFormat": {
            "type": "string"
          },
          "outputFormat": {
            "type": "string"
          },
          "limitScope": {
            "type": "string"
          },
          "functionName": {
            "type": "string"
          },
          "measurementScope": {
            "type": "string"
          },
          "supportedLanguages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Language"
            }
          },
          "languageProfiles": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/LanguageProfile"
            }
          }
        },
        "required": [
          "id",
          "supportedLanguages",
          "languageProfiles"
        ]
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "languages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Language"
            }
          },
          "modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxTestCases": {
            "type": "integer"
          },
          "adapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Adapter"
            }
          },
          "languageProfiles": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "modeProfiles": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "limitScope": {
                  "type": "string"
                },
                "measurementScope": {
                  "type": "string"
                },
                "sourceShape": {
                  "type": "string"
                }
              },
